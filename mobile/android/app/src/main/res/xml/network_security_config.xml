<?xml version="1.0" encoding="utf-8"?>
<!--
    Разрешает открытый HTTP (без TLS) для dev-стендов:
    - Адрес эмулятора Android: 10.0.2.2 (localhost хост-машины за NAT)
    - Локальная сеть 192.168.x.x: для реального устройства в той же сети
    Остальной трафик приложения по умолчанию идёт только по HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.66</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
