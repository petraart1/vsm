# Раздача собранного SPA + проксирование API на backend.
#
# BACKEND_URL и PORT — переменные окружения контейнера, подставляются envsubst'ом самого
# образа nginx:alpine (docker-entrypoint.d/20-envsubst-on-templates.sh) при старте контейнера:
# этот файл лежит в /etc/nginx/templates/*.template и рендерится в /etc/nginx/conf.d/default.conf
# заново при каждом запуске. Остальные "$"-переменные ($host, $remote_addr, ...) — встроенные
# переменные nginx, envsubst их не трогает (подставляет только реальные переменные окружения).
#
# Локально (docker compose) — BACKEND_URL=http://backend:8080 (имя сервиса в docker-сети),
# PORT=8080. На Render — BACKEND_URL задаётся в render.yaml (публичный https-адрес backend-сервиса),
# PORT подставляет сама платформа (контейнер обязан слушать именно его).

gzip on;
gzip_vary on;
gzip_comp_level 5;
gzip_min_length 256;
gzip_types
    text/plain
    text/css
    text/xml
    application/json
    application/javascript
    application/xml
    image/svg+xml
    font/woff2;

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Нужно, только если BACKEND_URL — https (Render): SNI на upstream-хендшейке по имени
    # хоста, а не по IP. Для http-апстрима (локальный compose) директива просто не используется.
    proxy_ssl_server_name on;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        # $proxy_host — хост:порт из proxy_pass (а не Host исходного запроса от клиента):
        # для Render это обязательно, иначе edge-роутинг по Host не найдёт backend-сервис.
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Живой таймер/шкалы прохождения (ru.vsm.backend.ws) — обычный WebSocket, не STOMP.
    location /ws/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    # Vite кладёт хэш содержимого в имя файла — такие ассеты можно кэшировать надолго.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
